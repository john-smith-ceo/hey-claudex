class HeyCodex < Formula
  desc "Voice input for Codex in tmux"
  homepage "https://github.com/{{OWNER}}/hey-claudex"
  url "https://github.com/{{OWNER}}/hey-claudex/archive/refs/tags/v{{VERSION}}.tar.gz"
  sha256 "{{SHA256}}"
  license "MIT"

  depends_on "ffmpeg"
  depends_on "tmux"
  depends_on "go" => :build

  def install
    ENV["CGO_ENABLED"] = "1"
    system "go", "build", *std_go_args(output: bin/"hey-claudex"), "./cmd/hey-claudex"
  end

  def caveats
    <<~EOS
      First-time setup:
        hey-claudex setup-api-key
        hey-claudex

      `hey-claudex` creates/resumes its tmux session and starts voice input.
      To remove everything deliberately: hey-claudex stop && brew uninstall hey-claudex
      API credentials stay in macOS Keychain unless you run: hey-claudex uninstall --purge-key
    EOS
  end

  test do
    assert_match "usage:", shell_output("#{bin}/hey-claudex help")
  end
end
