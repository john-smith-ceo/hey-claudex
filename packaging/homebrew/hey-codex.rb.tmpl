class HeyCodex < Formula
  desc "Voice input for Codex in tmux"
  homepage "https://github.com/{{OWNER}}/hey-codex"
  url "https://github.com/{{OWNER}}/hey-codex/archive/refs/tags/v{{VERSION}}.tar.gz"
  sha256 "{{SHA256}}"
  license "MIT"

  depends_on "ffmpeg"
  depends_on "tmux"
  depends_on "go" => :build

  def install
    ENV["CGO_ENABLED"] = "1"
    system "go", "build", *std_go_args(output: bin/"hey-codex"), "./cmd/hey-codex"
  end

  def caveats
    <<~EOS
      First-time setup:
        hey-codex setup-api-key
        hey-codex

      `hey-codex` creates/resumes its tmux session and starts voice input.
      To remove everything deliberately: hey-codex stop && brew uninstall hey-codex
      API credentials stay in macOS Keychain unless you run: hey-codex uninstall --purge-key
    EOS
  end

  test do
    assert_match "usage:", shell_output("#{bin}/hey-codex help")
  end
end
